<Application x:Class="MaxilunDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Maxilun Minimalist OKLCH-aligned Dark Palette -->
        <SolidColorBrush x:Key="BgBrush" Color="#0B0E17"/>
        <SolidColorBrush x:Key="CardBrush" Color="#101420"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#1C2233"/>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#5E6AD2"/>
        <SolidColorBrush x:Key="TextMainBrush" Color="#F7F8F8"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="#8A8F98"/>
    </Application.Resources>
</Application>
