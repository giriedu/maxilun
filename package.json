{
  "name": "maxilun",
  "version": "1.1.0",
  "description": "AI engineering co-pilot & autonomous agent runtime — 24 skills (1 master orchestrator + 23 specialists) + 13 autonomous agents, reversibility triage, in-process Knowledge Graph, AST security inspection, and interactive dashboard.",
  "keywords": [
    "ai-skills",
    "claude-code",
    "antigravity",
    "cursor",
    "codex",
    "agent-protocol",
    "purity-engine",
    "token-compression",
    "ui-ux",
    "seo",
    "code-intelligence",
    "motion-design",
    "database",
    "deployment",
    "frontend",
    "react-server-components",
    "nextjs",
    "docker",
    "ci-cd",
    "knowledge-graph",
    "programmatic-video",
    "cinecode",
    "project-scaffold",
    "context-docs",
    "skill-routing",
    "purity-gate",
    "design-reference-corpus",
    "powerbuilder",
    "desktop-app",
    "android",
    "ios",
    "iot",
    "embedded",
    "mikrotik",
    "routeros",
    "networking",
    "game-development",
    "godot",
    "unreal-engine",
    "unity"
  ],
  "author": "Maxilun Architecture",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/giriedu/maxilun.git"
  },
  "scripts": {
    "test": "python scripts/test-suite.py",
    "lint:ui": "python scripts/ui-purity-linter.py",
    "purity": "python harness/cli.py check",
    "harness": "python harness/cli.py",
    "bench": "python harness/cli.py bench",
    "install-skills": "node -e \"const{execSync}=require('child_process');const p=require('path');const s=p.join(__dirname,'scripts');process.platform==='win32'?execSync('powershell -ExecutionPolicy Bypass -File '+p.join(s,'install.ps1'),{stdio:'inherit'}):execSync('bash '+p.join(s,'install.sh'),{stdio:'inherit'})\"",
    "update-skills": "node -e \"const{execSync}=require('child_process');const p=require('path');const s=p.join(__dirname,'scripts');process.platform==='win32'?execSync('powershell -ExecutionPolicy Bypass -File '+p.join(s,'install.ps1'),{stdio:'inherit'}):execSync('bash '+p.join(s,'install.sh'),{stdio:'inherit'})\"",
    "uninstall-skills": "node -e \"const{execSync}=require('child_process');const p=require('path');const s=p.join(__dirname,'scripts');process.platform==='win32'?execSync('powershell -ExecutionPolicy Bypass -File '+p.join(s,'uninstall.ps1'),{stdio:'inherit'}):execSync('bash '+p.join(s,'uninstall.sh'),{stdio:'inherit'})\""
  },
  "files": [
    "skills/",
    "agents/",
    "!skills/**/__pycache__/**",
    "!skills/**/*.pyc",
    "!skills/**/.maxilun/**",
    "!skills/**/maxilun-out/**",
    "scripts/install.ps1",
    "scripts/install.sh",
    "scripts/uninstall.ps1",
    "scripts/uninstall.sh",
    "scripts/test-suite.py",
    "scripts/repomap.py",
    "scripts/ui-purity-linter.py",
    "docs/",
    "assets/",
    "README.md",
    "README.id.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "skills.sh.json",
    "harness/",
    "!harness/**/__pycache__/**",
    "!harness/**/*.pyc"
  ]
}
