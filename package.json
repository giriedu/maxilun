  "scripts": {
    "test": "python scripts/test-suite.py",
    "install-skills": "node -e \"const{execSync}=require('child_process');const p=require('path');const s=p.join(__dirname,'scripts');process.platform==='win32'?execSync('powershell -ExecutionPolicy Bypass -File '+p.join(s,'install.ps1'),{stdio:'inherit'}):execSync('bash '+p.join(s,'install.sh'),{stdio:'inherit'})\"",
    "update-skills": "node -e \"const{execSync}=require('child_process');const p=require('path');const s=p.join(__dirname,'scripts');process.platform==='win32'?execSync('powershell -ExecutionPolicy Bypass -File '+p.join(s,'install.ps1'),{stdio:'inherit'}):execSync('bash '+p.join(s,'install.sh'),{stdio:'inherit'})\"",
    "uninstall-skills": "node -e \"const{execSync}=require('child_process');const p=require('path');const s=p.join(__dirname,'scripts');process.platform==='win32'?execSync('powershell -ExecutionPolicy Bypass -File '+p.join(s,'uninstall.ps1'),{stdio:'inherit'}):execSync('bash '+p.join(s,'uninstall.sh'),{stdio:'inherit'})\""
  },
  "files": [
    "skills/",
    "scripts/",
    "docs/",
    "README.md",
    "README.id.md",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "skills.sh.json"
  ]
}
